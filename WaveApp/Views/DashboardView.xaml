<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WaveApp.ViewModels"
             x:Class="WaveApp.Views.DashboardView"
             x:DataType="vm:DashboardViewModel"
             BackgroundColor="#0F1117"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *" RowSpacing="1" BackgroundColor="#2a2c36">

        <Grid Grid.Row="0" Padding="24,16" BackgroundColor="#0F1117">
            <VerticalStackLayout>
                <Label Text="Dashboard" TextColor="#e8eaf0" FontSize="16" FontAttributes="Bold"/>
                <Label Text="Visão geral do sistema" TextColor="#4a5068" FontSize="12"/>
            </VerticalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1" Padding="24" BackgroundColor="#0F1117">
            <VerticalStackLayout Spacing="24">

                <Grid ColumnDefinitions="*, *, *" ColumnSpacing="14">

                    <Border Grid.Column="0" BackgroundColor="#1a1c26" Stroke="#2a2c36">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Padding="18">
                            <Border BackgroundColor="#0c2a4a" WidthRequest="36" HeightRequest="36" HorizontalOptions="Start" Margin="0,0,0,14">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8"/>
                                </Border.StrokeShape>
                                <Label Text="👥" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Text="TOTAL DE ALUNOS" TextColor="#4a5068" FontSize="11"/>
                            <Label Text="0" TextColor="#e8eaf0" FontSize="28" FontAttributes="Bold" Margin="0,6,0,0"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" BackgroundColor="#1a1c26" Stroke="#2a2c36">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Padding="18">
                            <Border BackgroundColor="#0e2a1a" WidthRequest="36" HeightRequest="36" HorizontalOptions="Start" Margin="0,0,0,14">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8"/>
                                </Border.StrokeShape>
                                <Label Text="✅" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Text="ALUNOS ATIVOS" TextColor="#4a5068" FontSize="11"/>
                            <Label Text="teste" TextColor="#e8eaf0" FontSize="28" FontAttributes="Bold" Margin="0,6,0,0"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="2" BackgroundColor="#1a1c26" Stroke="#2a2c36">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Padding="18">
                            <Border BackgroundColor="#2a0e0e" WidthRequest="36" HeightRequest="36" HorizontalOptions="Start" Margin="0,0,0,14">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8"/>
                                </Border.StrokeShape>
                                <Label Text="⛔" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Text="ALUNOS INATIVOS" TextColor="#4a5068" FontSize="11"/>
                            <Label Text="teste" TextColor="#e8eaf0" FontSize="28" FontAttributes="Bold" Margin="0,6,0,0"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <VerticalStackLayout>
                    <Label Text="PRÓXIMAS AULAS" TextColor="#8890a4" FontSize="12" FontAttributes="Bold" Margin="0,0,0,14"/>

                    <Border BackgroundColor="#1a1c26" Stroke="#2a2c36">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>

                        <CollectionView ItemsSource="teste">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="2*, *, *, *" Padding="18,11">
                                        <Label Grid.Column="0" Text="teste" TextColor="#c8cad4" FontSize="13" VerticalOptions="Center"/>
                                        <Label Grid.Column="1" Text="teste" TextColor="#6b7080" FontSize="12" VerticalOptions="Center"/>
                                        <Label Grid.Column="2" Text="teste" TextColor="#6b7080" FontSize="12" VerticalOptions="Center"/>
                                        <Label Grid.Column="3" Text="teste" TextColor="#378ADD" FontSize="12" VerticalOptions="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>